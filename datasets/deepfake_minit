from __future__ import print_function

import os
from os.path import join
#os.path.join()：将多个路径进行拼接。或者称之为合并目录。

import numpy as np
import torch.utils.data as data
from PIL import Image

import torchvision.transforms as transforms
from .utils import download_url, check_integrity, list_dir, list_files


class Omniglot(data.Dataset):
    """`Omniglot <https://github.com/brendenlake/omniglot>`_ Dataset.
    Args:
        root (string): Root directory of dataset where directory
            ``omniglot-py`` exists.
        background (bool, optional): If True, creates dataset from the "background" set, otherwise
            creates from the "evaluation" set. This terminology is defined by the authors.
        transform (callable, optional): A function/transform that  takes in an PIL image
            and returns a transformed version. E.g, ``transforms.RandomCrop``
        target_transform (callable, optional): A function/transform that takes in the
            target and transforms it.
        download (bool, optional): If true, downloads the dataset zip files from the internet and
            puts it in root directory. If the zip files are already downloaded, they are not
            downloaded again.
    ”“‘Omniglot < https://github.com/brendenlake/omniglot > ' _数据集。
    参数:
    root (string):数据集的根目录
    “omniglot-py“的存在。
    background (bool，可选):如果为True，则从“背景”集创建数据集，否则
    从“评估”集创建。这个术语由作者定义。
    transform(可调用，可选):接收PIL图像的函数/transform
    并返回转换后的版本。如”、“变换。RandomCrop ' '
    target_transform(可调用，可选):一个接受
    确定目标并转换它。
    download (bool，可选):如果为真值，则从互联网上下载数据集zip文件
    把它放在根目录中。如果zip文件已经下载，则不会下载
    再次下载。
”“”
    """
    folder = 'omniglot-py'
    download_url_prefix = 'https://github.com/brendenlake/omniglot/raw/master/python'
    zips_md5 = {
        'images_background': '68d2efa1b9178cc56df9314c21c6e718',
        'images_evaluation': '6b91aef0f799c5bb55b94e3f2daec811'
    }

    def __init__(self, root, background=True,
                 transform=None, target_transform=None,
                 download=False, train=True, all=False):
        self.root = join(os.path.expanduser(root), self.folder)    #文件夹
        self.background = background
        self.transform = transform
        self.target_transform = target_transform
        self.images_cached = {}

        if download:
            self.download()

        if not self._check_integrity():
            raise RuntimeError('Dataset not found or corrupted.' +
                               ' You can use download=True to download it') #数据集未发现
        #为读取图片做准备
        self.target_folder = join(self.root, self._get_target_folder())  #连接根目录和文件夹，找到目标文件夹
        self._alphabets = list_dir(self.target_folder)    #返回一个列表，其中包含由path指定的目录中的条目的名称
        self._characters = sum([[join(a, c) for c in list_dir(join(self.target_folder, a))]
                                for a in self._alphabets], [])   #二级目录下的三级目录（1×20+2×26...种）characters，全合并并在后面连接一个空的列表[]
        self._character_images = [[(image, idx) for image in list_files(join(self.target_folder, character), '.png')]
                                  for idx, character in enumerate(self._characters)]    #将图片读取出来


        self._flat_character_images = sum(self._character_images, [])   #在二维列表(image,idx)后面接一个空列表[]
        self.data = [x[0] for x in self._flat_character_images]      #获取数据和索引
        self.targets = [x[1] for x in self._flat_character_images]
        self.data2 = []
        self.targets2 = []
        self.new_flat = []
        for a in range(int(len(self.targets) / 20)):  #索引/20:100/20=5个任务， a是任务数a=0~4
            start = a * 20   #每个任务的20个图像数据量
            if train:
                for b in range(start, start + 15):    #15个用于元测试训练
                    self.data2.append(self.data[b])
                    self.targets2.append(self.targets[b])
                    self.new_flat.append(self._flat_character_images[b])
                    # print(self.targets[start+b])
            else:
                for b in range(start + 15, start + 20):  # (start + 15, start + 20):     #5个用于元测试测试
                    self.data2.append(self.data[b])
                    self.targets2.append(self.targets[b])
                    self.new_flat.append(self._flat_character_images[b])

        if all:
            pass
        else:
            self._flat_character_images = self.new_flat
            self.targets = self.targets2
            print(self.targets[0:30])
            self.data = self.data2

        print("Total classes = ", np.max(self.targets))  #np.max返回targets列的最大值
    def __len__(self):
        return len(self.data)

    def __getitem__(self, index):
        """
        Args:
            index (int): Index
        Returns:
            tuple: (image, target) where target is index of the target character class.
        """
        image_name = self.data[index]
        character_class = self.targets[index]
        image_path = join(self.target_folder, self._characters[character_class], image_name)

        if image_path not in self.images_cached:

            image = Image.open(image_path, mode='r').convert('RGB')  # L
            image = image.resize((28, 28), resample=Image.LANCZOS)
            image = np.array(image, dtype=np.float32)
            normalize = transforms.Normalize(mean=[0.92206 * 256, 0.92206 * 256, 0.92206 * 256],
                                             std=[0.08426 * 256 * 256, 0.08426 * 256 * 256,
                                                  0.08426 * 256 * 256])  # adjust means and std of input data
            self.transform = transforms.Compose([transforms.ToTensor(), normalize])
            if self.transform is not None:
                image = self.transform(image)

            self.images_cached[image_path] = image
        else:
            image = self.images_cached[image_path]

        if self.target_transform:
            character_class = self.target_transform(character_class)

        return image, character_class

    def _cache_data(self):
        pass

    def _check_integrity(self):
        zip_filename = self._get_target_folder()
        if not check_integrity(join(self.root, zip_filename + '.zip'), self.zips_md5[zip_filename]):
            return False
        return True

    def download(self):
        import zipfile

        if self._check_integrity():
            print('Files already downloaded and verified')
            return

        filename = self._get_target_folder()
        zip_filename = filename + '.zip'
        url = self.download_url_prefix + '/' + zip_filename
        download_url(url, self.root, zip_filename, self.zips_md5[filename])
        print('Extracting downloaded file: ' + join(self.root, zip_filename))
        with zipfile.ZipFile(join(self.root, zip_filename), 'r') as zip_file:
            zip_file.extractall(self.root)

    def _get_target_folder(self):
        return 'images_background' if self.background else 'images_evaluation'
